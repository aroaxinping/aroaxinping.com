---
import Base from '../layouts/Base.astro';

// Coordenadas y conexiones tal cual el about.html original: es un layout que
// ya se probó y se ve bien, no hacía falta recalcularlo.
const nodos = [
  { id: 'datos', grupo: 'datos', x: 572.0, y: 381.7, r: 17.0, label: 'datos' },
  { id: 'python', grupo: 'datos', x: 522.1, y: 351.9, r: 9.5, label: 'Python' },
  { id: 'sql', grupo: 'datos', x: 736.8, y: 412.8, r: 8.0, label: 'SQL' },
  { id: 'estadistica', grupo: 'datos', x: 521.1, y: 470.0, r: 8.0, label: 'estadística' },
  { id: 'viz', grupo: 'datos', x: 409.2, y: 435.5, r: 9.5, label: 'visualización' },
  { id: 'uoc', grupo: 'datos', x: 682.5, y: 304.2, r: 11.0, label: 'UOC' },
  { id: 'ironhack', grupo: 'datos', x: 810.0, y: 359.8, r: 8.0, label: 'Ironhack' },
  { id: 'bellasartes', grupo: 'diseno', x: 90.0, y: 436.1, r: 8.0, label: 'Bellas Artes' },
  { id: 'diseno', grupo: 'diseno', x: 225.2, y: 387.2, r: 12.5, label: 'diseño' },
  { id: 'pixelart', grupo: 'diseno', x: 96.3, y: 385.1, r: 9.5, label: 'pixel art' },
  { id: 'estaweb', grupo: 'diseno', x: 333.1, y: 360.7, r: 11.0, label: 'esta web' },
  { id: 'easter', grupo: 'diseno', x: 179.0, y: 332.3, r: 9.5, label: 'easter eggs' },
  { id: 'contenido', grupo: 'contenido', x: 510.8, y: 291.9, r: 12.5, label: 'contenido' },
  { id: 'tiktok', grupo: 'contenido', x: 600.6, y: 305.3, r: 9.5, label: 'TikTok' },
  { id: 'instagram', grupo: 'contenido', x: 564.7, y: 241.5, r: 8.0, label: 'Instagram' },
  { id: 'documentar', grupo: 'contenido', x: 449.2, y: 359.1, r: 9.5, label: 'documentar' },
