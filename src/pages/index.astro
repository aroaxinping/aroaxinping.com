---
import Base from '../layouts/Base.astro';
import SelectorModelo from '../components/SelectorModelo.astro';

const chips = [
  '¿quién eres?',
  '¿qué proyectos tienes?',
  '¿por qué no eres un LLM?',
];
---

<Base
  title="aroa.ai — aroa-1"
  description="aroa-1: un modelo de recuperación entrenado por Aroa Xinping sobre su propio corpus. Sin backend, sin coste, corriendo en tu navegador."
>
  <section class="chat-page" id="chatPage" data-estado="idle">
    <div class="wrap chat-grid">
      <!-- ═══ Consola ═══ -->
      <div class="consola">
        <SelectorModelo />

        <!-- El estado de carga real vive en la consola del navegador y en
             la ficha lateral; en la pantalla de bienvenida no aporta, solo
             ruido antes de un saludo que debería ser lo primero que se lea. -->
        <div id="boot" class="boot mono sr-only" aria-live="polite"></div>

        <div id="heroCopy" class="hero-copy" hidden>
          <h1 class="hero-tit">Hola, soy aroa-1.</h1>
        </div>

        <div id="hilo" class="hilo" aria-live="polite" hidden></div>

        <div id="chips" class="chips" hidden>
          {chips.map((c) => <button class="chip mono" type="button">{c}</button>)}
        </div>

        <div class="zona-form" hidden id="zonaForm">
          <ul id="sugerencias" class="sugerencias mono" hidden role="listbox"></ul>

          <form id="form" class="form">
            <span class="prompt mono" aria-hidden="true">&gt;</span>
            <input
              id="input"
              class="input mono"
              type="text"
              autocomplete="off"
              spellcheck="false"
              placeholder="pregúntale algo a aroa-1…"
              aria-label="Tu pregunta para aroa-1"
            />
            <button
              type="button"
              id="micBtn"
              class="mic"
              hidden
              aria-label="Preguntar por voz"
              aria-pressed="false"
            >
              <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
                <path
                  fill="currentColor"
                  d="M12 15a3 3 0 0 0 3-3V6a3 3 0 0 0-6 0v6a3 3 0 0 0 3 3Zm5-3a5 5 0 0 1-10 0H5a7 7 0 0 0 6 6.93V21h2v-2.07A7 7 0 0 0 19 12h-2Z"
                />
              </svg>
            </button>
            <button class="enviar mono" type="submit">enviar</button>
          </form>

          <p class="pista mono">escribe <span>/</span> para ver los comandos</p>
        </div>
      </div>

      <!-- ═══ Ficha del modelo ═══ -->
      <aside class="ficha" id="ficha" hidden>
        <details open>
          <summary class="eyebrow">aroa-1 · ficha</summary>
          <dl class="mono" id="ficha-datos"></dl>

          <label class="toggle mono">
            <input type="checkbox" id="debugChk" />
            <span>explicar cada respuesta</span>
          </label>

          <p class="ficha-link">
            <a class="enlace" href="/model-card">model card →</a><br />
            <a class="enlace" href="/eval">evaluación completa →</a>
          </p>
        </details>
      </aside>
    </div>
  </section>
</Base>

<style>
  .chat-page {
    position: relative;
    padding-block: clamp(1.5rem, 4vw, 2.5rem) 3rem;
    min-height: calc(100dvh - 58px - 90px);
  }

  .chat-grid {
    display: grid;
    grid-template-columns: 1fr 260px;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }

  .consola { min-width: 0; }

  /* ---- Estado inicial: hero centrado, sin conversación todavía ---- */
  .chat-page[data-estado='idle']::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(
      ellipse 640px 420px at 50% 38%,
      color-mix(in srgb, var(--accent) 16%, transparent),
      transparent 70%
    );
    pointer-events: none;
  }
  .chat-page[data-estado='idle'] .chat-grid {
    grid-template-columns: 1fr;
    min-height: calc(100dvh - 58px - 90px - 4rem);
    align-content: center;
    justify-items: center;
  }
  .chat-page[data-estado='idle'] .ficha { display: none; }
  .chat-page[data-estado='idle'] .consola {
    width: 100%;
    max-width: 620px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .chat-page[data-estado='idle'] .chips { justify-content: center; }
  .chat-page[data-estado='idle'] .zona-form,
  .chat-page[data-estado='idle'] .chips { width: 100%; }

  .hero-copy { margin-bottom: 1.8rem; }
  .hero-tit {
    font-size: clamp(1.8rem, 5vw, 2.7rem);
    font-weight: 600;
    letter-spacing: -.015em;
    background: linear-gradient(135deg, var(--fg), color-mix(in srgb, var(--accent) 70%, var(--fg)));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .boot {
    color: var(--fg-3);
    font-size: .85rem;
    line-height: 1.9;
  }
  .boot p { opacity: 0; animation: aparece .25s ease forwards; }
  .cursor { animation: parpadeo 1s step-end infinite; color: var(--accent); }

  .hilo { display: flex; flex-direction: column; gap: 1.4rem; margin-bottom: 1.6rem; }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: .55rem;
    margin-bottom: 1.4rem;
  }
  .chip {
    font-size: .78rem;
    color: var(--fg-2);
    background: var(--bg-2);
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: .45rem .9rem;
    cursor: pointer;
    transition: border-color .18s, color .18s;
  }
  .chip:hover { border-color: var(--accent); color: var(--fg); }

  .zona-form { position: relative; }

  .form {
    display: flex;
    align-items: center;
    gap: .6rem;
    background: var(--bg-2);
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: .7rem .55rem .7rem 1.1rem;
  }

  /* Lista de comandos, flotando encima del input para no empujar nada */
  .sugerencias {
    position: absolute;
    bottom: calc(100% + .4rem);
    left: 0;
    right: 0;
    z-index: 5;
    list-style: none;
    background: var(--bg-2);
    border: 1px solid var(--rule);
    border-radius: var(--radio);
    padding: .3rem;
    max-height: 240px;
    overflow-y: auto;
    box-shadow: 0 8px 24px rgb(0 0 0 / .25);
  }
  .sugerencias li {
    display: flex;
    gap: .8rem;
    align-items: baseline;
    padding: .4rem .6rem;
    border-radius: 6px;
    font-size: .78rem;
    color: var(--fg-2);
    cursor: pointer;
  }
  .sugerencias li[aria-selected='true'] { background: var(--bg-3); color: var(--fg); }
  .sugerencias b { font-weight: 500; color: var(--accent); }
  .sugerencias span { color: var(--fg-3); font-size: .72rem; }

  .pista {
    margin-top: .5rem;
    font-size: .68rem;
    color: var(--fg-3);
    text-align: right;
  }
  .pista span { color: var(--accent); }
  .form:focus-within { border-color: var(--accent); }
  .prompt { color: var(--accent); font-size: .95rem; }
  .input {
    flex: 1;
    min-width: 0;
    background: none;
    border: none;
    color: var(--fg);
    font-size: .92rem;
  }
  .input:focus { outline: none; }
  .input::placeholder { color: var(--fg-3); }
  .enviar {
    font-size: .78rem;
    color: var(--bg);
    background: var(--accent);
    border: none;
    border-radius: 6px;
    padding: .5rem .9rem;
    cursor: pointer;
    transition: opacity .15s;
    flex-shrink: 0;
  }
  .enviar:hover { opacity: .85; }
  .enviar:disabled { opacity: .4; cursor: default; }

  .mic {
    display: grid;
    place-items: center;
    width: 30px; height: 30px;
    flex-shrink: 0;
    color: var(--fg-3);
    background: none;
    border: 1px solid var(--rule);
    border-radius: 50%;
    cursor: pointer;
    transition: color .15s, border-color .15s;
  }
  .mic:hover { color: var(--fg); border-color: var(--accent); }
  .mic[aria-pressed='true'] {
    color: var(--bg);
    background: var(--accent);
    border-color: var(--accent);
    animation: pulso 1.1s ease-in-out infinite;
  }
  @keyframes pulso {
    50% { box-shadow: 0 0 0 6px color-mix(in srgb, var(--accent) 25%, transparent); }
  }

  /* ---- Ficha lateral ---- */
  .ficha { font-size: .8rem; }
  .ficha summary { cursor: pointer; margin-bottom: .9rem; list-style: none; }
  .ficha summary::-webkit-details-marker { display: none; }
  .ficha dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: .5rem 1rem;
    font-size: .78rem;
  }
  .ficha dt { color: var(--fg-3); }
  .ficha dd { color: var(--fg); text-align: right; }
  .ficha-link { margin-top: 1.1rem; font-size: .78rem; line-height: 1.9; }

  .toggle {
    display: flex;
    align-items: center;
    gap: .5rem;
    margin-top: 1.2rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--rule);
    font-size: .74rem;
    color: var(--fg-3);
    cursor: pointer;
  }
  .toggle:hover { color: var(--fg-2); }
  .toggle input { accent-color: var(--accent); cursor: pointer; }

  @keyframes aparece { to { opacity: 1; } }
  @keyframes parpadeo { 50% { opacity: 0; } }

  @media (max-width: 860px) {
    .chat-grid { grid-template-columns: 1fr; }
    .ficha { order: -1; border-bottom: 1px solid var(--rule); padding-bottom: 1.2rem; }
    .ficha dl { grid-template-columns: repeat(2, auto); }
  }
</style>

<!--
  Los mensajes del chat los crea el JavaScript, y a esos nodos no les llega el
  atributo de ámbito que Astro pone en tiempo de compilación: con `<style>`
  normal estas reglas no se aplicarían nunca. Van globales, colgando de
  `.chat-page` para que no se escapen al resto del sitio.
-->
<style is:global>
  .chat-page .msg { max-width: var(--measure); }

  .chat-page .msg-yo .burbuja {
    font-family: var(--font-mono);
    font-size: .9rem;
    color: var(--fg);
  }
  .chat-page .msg-yo .burbuja::before { content: '> '; color: var(--accent); }

  .chat-page .msg-modelo .burbuja {
    font-size: 1.02rem;
    line-height: 1.65;
    color: var(--fg);
  }
  .chat-page .msg-modelo.falla .burbuja { color: var(--fg-2); font-style: italic; }

  /* Salida de comando: es de la máquina, no del modelo — se nota en la forma */
  .chat-page .msg-sistema .salida {
    font-size: .76rem;
    line-height: 1.75;
    color: var(--fg-2);
    white-space: pre-wrap;
    overflow-x: auto;
    padding: .8rem 1rem;
    background: var(--bg-2);
    border: 1px solid var(--rule);
    border-left: 2px solid var(--accent);
    border-radius: 0 6px 6px 0;
  }

  .chat-page .meta {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
    margin-top: .6rem;
  }

  /* ---- Explicación del retrieval ---- */
  .chat-page .explica { margin-top: .9rem; }
  .chat-page .explica summary {
    font-size: .72rem;
    color: var(--fg-3);
    cursor: pointer;
    padding: .25rem 0;
  }
  .chat-page .explica summary:hover { color: var(--accent); }
  .chat-page .explica[open] summary { color: var(--fg-2); margin-bottom: .7rem; }
  .chat-page .explica-tit {
    font-size: .64rem;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--fg-3);
    margin: .9rem 0 .45rem;
  }
  .chat-page .explica-tit:first-of-type { margin-top: 0; }

  .chat-page .candidatos {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: .3rem;
    padding: 0;
  }
  .chat-page .candidatos li {
    display: grid;
    grid-template-columns: minmax(6rem, 10rem) 1fr 3rem;
    gap: .6rem;
    align-items: center;
  }
  .chat-page .cand-id {
    font-size: .68rem;
    color: var(--fg-3);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .chat-page .candidatos .gana .cand-id { color: var(--accent); }
  .chat-page .cand-barra {
    height: 5px;
    background: var(--bg-3);
    border-radius: 999px;
    overflow: hidden;
  }
  .chat-page .cand-barra i { display: block; height: 100%; background: var(--fg-3); border-radius: 999px; }
  .chat-page .candidatos .gana .cand-barra i { background: var(--accent); }
  .chat-page .cand-score { font-size: .66rem; color: var(--fg-3); text-align: right; }

  .chat-page .terminos { display: flex; flex-wrap: wrap; gap: .35rem; }
  .chat-page .term {
    font-size: .68rem;
    color: var(--fg-2);
    background: var(--bg-3);
    border-radius: 4px;
    padding: .15rem .45rem;
    white-space: pre;
  }
  .chat-page .term.es-char { color: var(--fg-3); opacity: .75; }
  .chat-page .explica-pie { font-size: .64rem; color: var(--fg-3); margin-top: .8rem; line-height: 1.6; }
</style>

<script>
  import { preguntar, cargarModelo } from '../lib/infer.js';
  import { COMANDOS, esComando, ejecutar, sugerencias } from '../lib/comandos.js';
  import { soportado as vozSoportada, escuchar } from '../lib/voz.js';

  const FALLOS = [
    'No tengo datos de entrenamiento sobre eso. Mi corpus son unas decenas de documentos escritos por Aroa, no internet entero.',
    'Eso se sale de mi corpus. Puedo hablarte de sus estudios, sus proyectos o su trabajo, pero no de esto.',
    'No lo sé, y prefiero decirlo a inventar algo con cara de seguro. Prueba con alguna de las preguntas sugeridas.',
  ];

  // Modo explicación: se hereda de ?debug=1 o de lo que se dejó activado.
  let debug =
    new URLSearchParams(location.search).get('debug') === '1' ||
    localStorage.getItem('debug') === '1';

  const chatPage = document.getElementById('chatPage');
  const boot = document.getElementById('boot');
  const heroCopy = document.getElementById('heroCopy');
  const hilo = document.getElementById('hilo');
  const chipsWrap = document.getElementById('chips');
  const form = document.getElementById('form');
  const input = document.getElementById('input');
  const ficha = document.getElementById('ficha');
  const fichaDatos = document.getElementById('ficha-datos');
  const debugChk = document.getElementById('debugChk');
  const zonaForm = document.getElementById('zonaForm');
  const listaSug = document.getElementById('sugerencias');
  const selector = document.getElementById('selector');
  const selBtn = document.getElementById('selBtn');
  const selPanel = document.getElementById('selPanel');
  const selScrim = document.getElementById('selScrim');
  const selNombre = document.getElementById('selNombre');
  const selProgreso = document.getElementById('selProgreso');
  const selBarra = document.getElementById('selBarra');
  const selEstado = document.getElementById('selEstado');

  let variante = 'aroa-1-flash';

  const micBtn = document.getElementById('micBtn');
  if (vozSoportada()) {
    micBtn.hidden = false;
    micBtn.addEventListener('click', async () => {
      micBtn.setAttribute('aria-pressed', 'true');
      try {
        const texto = await escuchar({
          onEscuchando: () => { input.placeholder = 'escuchando…'; },
        });
        input.value = texto;
        input.focus();
      } catch {
        // Silencio, mano atrás del micro o sin permiso: no hay nada que
        // decir que no se note ya en que el botón deja de estar activo.
      } finally {
        micBtn.setAttribute('aria-pressed', 'false');
        input.placeholder = 'pregúntale algo a aroa-1…';
      }
    });
  }

  function esc(s) {
    const d = document.createElement('div');
    d.textContent = s;
    return d.innerHTML;
  }

  function pintarFicha(modelo) {
    const m = modelo.metricas;
    const filas = [
      ['versión', modelo.version],
      ['documentos', m.documentos],
      ['vocabulario', `${m.vocabulario} terms`],
      ['accuracy@1', `${Math.round(m.accuracy_top1 * 100)}%`],
      ['entrenado', modelo.entrenado],
      ['carga', `${modelo.cargaMs} ms`],
    ];
    fichaDatos.innerHTML = filas
      .map(([k, v]) => `<dt>${esc(k)}</dt><dd>${esc(String(v))}</dd>`)
      .join('');
    ficha.hidden = false;

    debugChk.checked = debug;
    debugChk.addEventListener('change', () => {
      debug = debugChk.checked;
      localStorage.setItem('debug', debug ? '1' : '0');
    });
  }

  function addMsgYo(texto) {
    const div = document.createElement('div');
    div.className = 'msg msg-yo';
    div.innerHTML = `<p class="burbuja">${esc(texto)}</p>`;
    hilo.appendChild(div);
    return div;
  }

  /**
   * `escribirLuego` lo usa el modo generativo: pinta la burbuja vacía para
   * poder ir rellenándola cuando el LLM termine.
   */
  function addMsgModelo({ doc, score, bajoUmbral, ms, candidatos, terminos }, escribirLuego = false) {
    const div = document.createElement('div');
    div.className = 'msg msg-modelo' + (bajoUmbral ? ' falla' : '');
    const texto = bajoUmbral
      ? FALLOS[Math.floor(Math.random() * FALLOS.length)]
      : doc.respuesta;
    div.innerHTML = `
      <p class="burbuja"></p>
      <div class="meta">
        <span class="tag mono">score ${score.toFixed(3)}</span>
        ${!bajoUmbral ? `<span class="tag mono">doc: ${esc(doc.id)}</span>` : ''}
        <span class="tag mono">${ms} ms</span>
      </div>
      ${explicacion(candidatos, terminos)}
    `;
    hilo.appendChild(div);
    if (!escribirLuego) escribir(div.querySelector('.burbuja'), texto);
    return div;
  }

  /**
   * El desglose del score: los candidatos que compitieron y los términos que
   * decidieron. Sólo se pinta con el modo explicación activo — el resto del
   * tiempo estorbaría.
   */
  function explicacion(candidatos, terminos) {
    if (!debug || !candidatos?.length) return '';
    const tope = candidatos[0].score || 1;

    const filas = candidatos
      .map(
        (c, i) => `
        <li class="${i === 0 ? 'gana' : ''}">
          <span class="cand-id mono">${esc(c.id)}</span>
          <span class="cand-barra"><i style="width:${(c.score / tope) * 100}%"></i></span>
          <span class="cand-score mono">${c.score.toFixed(3)}</span>
        </li>`,
      )
      .join('');

    const chips = terminos
      .map(
        (t) =>
          `<span class="term mono ${t.esChar ? 'es-char' : ''}" title="aporta ${t.aporte.toFixed(4)} al score">${esc(t.termino)}</span>`,
      )
      .join('');

    return `
      <details class="explica">
        <summary class="mono">por qué esta respuesta</summary>
        <p class="explica-tit mono">candidatos</p>
        <ol class="candidatos">${filas}</ol>
        <p class="explica-tit mono">términos que más pesaron</p>
        <div class="terminos">${chips}</div>
        <p class="explica-pie mono">
          cada término aporta peso_consulta × peso_documento al coseno ·
          <span class="es-char">gris</span> = n-grama de caracteres
        </p>
      </details>
    `;
  }

  function escribir(el, texto) {
    // setInterval en vez de requestAnimationFrame: rAF se pausa si la pestaña
    // pierde el foco y la respuesta se queda a medias.
    let i = 0;
    const paso = 3;
    const id = setInterval(() => {
      i += paso;
      el.textContent = texto.slice(0, i);
      if (i >= texto.length) {
        el.textContent = texto;
        clearInterval(id);
      }
    }, 16);
  }

  /** Respuesta de un comando: monoespaciada y sin efecto de escritura. */
  function addMsgSistema(texto) {
    const div = document.createElement('div');
    div.className = 'msg msg-sistema';
    div.innerHTML = `<pre class="salida mono"></pre>`;
    div.querySelector('.salida').textContent = texto;
    hilo.appendChild(div);
    return div;
  }

  const alFinal = () => hilo.scrollIntoView({ block: 'end', behavior: 'smooth' });

  async function enviar(texto) {
    chatPage.dataset.estado = 'activo';
    addMsgYo(texto);
    alFinal();

    if (esComando(texto)) {
      const salida = ejecutar(texto, {
        modelo: await cargarModelo(),
        variante,
        alternarDebug: () => {
          debug = !debug;
          debugChk.checked = debug;
          localStorage.setItem('debug', debug ? '1' : '0');
          return debug;
        },
        limpiar: () => {
          hilo.replaceChildren();
        },
      });
      if (salida) addMsgSistema(salida);
      alFinal();
      return;
    }

    const resultado = await preguntar(texto);

    // El generativo sólo entra cuando el retrieval ha encontrado algo. Si no
    // llega al umbral, el fallback se dice igual: darle contexto vacío a un
    // LLM para que improvise sería justo lo que este sitio promete no hacer.
    if (variante === 'aroa-1-pro' && !resultado.bajoUmbral) {
      const msg = addMsgModelo(resultado, true);
      const burbuja = msg.querySelector('.burbuja');
      burbuja.textContent = 'redactando…';
      try {
        const { generar } = await import('../lib/generative.js');
        const redactado = await generar(texto, resultado.candidatos.slice(0, 3));
        burbuja.textContent = '';
        escribir(burbuja, redactado);
      } catch (err) {
        burbuja.textContent = resultado.doc.respuesta;
        addMsgSistema(`el modo generativo ha fallado (${err.message}); te dejo el documento tal cual.`);
      }
      alFinal();
      return;
    }

    addMsgModelo(resultado);
    alFinal();
  }

  // ── Selector de variante ──────────────────────────────────────────────────
  function cerrarSelector() {
    selPanel.hidden = true;
    selScrim.hidden = true;
    selBtn.setAttribute('aria-expanded', 'false');
  }

  selBtn.addEventListener('click', () => {
    const abierto = !selPanel.hidden;
    selPanel.hidden = abierto;
    selScrim.hidden = abierto;
    selBtn.setAttribute('aria-expanded', String(!abierto));
  });

  document.addEventListener('click', (e) => {
    if (!selector.contains(e.target)) cerrarSelector();
  });
  selScrim.addEventListener('click', cerrarSelector);

  selPanel.addEventListener('click', async (e) => {
    const op = e.target.closest('.opcion');
    if (!op || op.disabled) return;

    const elegida = op.dataset.variante;
    if (elegida === variante) return cerrarSelector();

    if (elegida === 'aroa-1-pro') {
      const { soportado, cargar } = await import('../lib/generative.js');
      if (!(await soportado())) return; // el botón ya está deshabilitado con el motivo

      selProgreso.hidden = false;
      op.disabled = true;
      try {
        await cargar((info) => {
          selBarra.style.width = `${Math.round((info.progress ?? 0) * 100)}%`;
          selEstado.textContent = info.text ?? 'descargando…';
        });
      } catch (err) {
        selEstado.textContent = `no se pudo cargar: ${err.message}`;
        op.disabled = false;
        return;
      }
      selProgreso.hidden = true;
      op.disabled = false;
    }

    variante = elegida;
    selNombre.textContent = variante;
    selPanel
      .querySelectorAll('.opcion')
      .forEach((o) => o.setAttribute('aria-selected', String(o.dataset.variante === variante)));
    cerrarSelector();
    addMsgSistema(
      variante === 'aroa-1-pro'
        ? 'aroa-1-pro activo. El retrieval sigue eligiendo los documentos; el LLM sólo los redacta.'
        : 'aroa-1-flash activo. Recuperación pura, sin generación.',
    );
    alFinal();
  });

  /** Deja el desplegable coherente con lo que este navegador puede hacer. */
  async function prepararSelector() {
    const { soportado } = await import('../lib/generative.js');
    selPanel.querySelector('[data-variante="aroa-1-flash"] [data-estado]').textContent =
      'ya cargada';

    const opPro = selPanel.querySelector('[data-variante="aroa-1-pro"]');
    const estado = opPro.querySelector('[data-estado]');

    if (await soportado()) {
      estado.textContent = 'disponible';
    } else {
      opPro.disabled = true;
      estado.textContent = 'sin WebGPU en este navegador';
    }
    selector.hidden = false;
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const texto = input.value.trim();
    if (!texto) return;
    input.value = '';
    ocultarSugerencias();
    enviar(texto);
  });

  // ── Autocompletado de comandos ────────────────────────────────────────────
  let seleccion = 0;

  function ocultarSugerencias() {
    listaSug.hidden = true;
    seleccion = 0;
  }

  function pintarSugerencias() {
    const nombres = sugerencias(input.value);
    if (!nombres.length) return ocultarSugerencias();

    seleccion = Math.min(seleccion, nombres.length - 1);
    listaSug.innerHTML = nombres
      .map(
        (n, i) =>
          `<li role="option" data-cmd="${n}" aria-selected="${i === seleccion}">
             <b>/${n}</b>${COMANDOS[n].args ? ` ${esc(COMANDOS[n].args)}` : ''}
             <span>${esc(COMANDOS[n].desc)}</span>
           </li>`,
      )
      .join('');
    listaSug.hidden = false;
  }

  function completar(nombre) {
    input.value = `/${nombre}${COMANDOS[nombre].args ? ' ' : ''}`;
    ocultarSugerencias();
    input.focus();
  }

  input.addEventListener('input', pintarSugerencias);

  input.addEventListener('keydown', (e) => {
    if (listaSug.hidden) return;
    const opciones = [...listaSug.querySelectorAll('li')];

    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
      e.preventDefault();
      seleccion =
        (seleccion + (e.key === 'ArrowDown' ? 1 : -1) + opciones.length) % opciones.length;
      pintarSugerencias();
    } else if (e.key === 'Tab' || (e.key === 'Enter' && opciones.length)) {
      // Enter completa si aún no hay comando entero escrito; si ya lo hay,
      // deja que el submit haga su trabajo.
      const nombre = opciones[seleccion].dataset.cmd;
      if (e.key === 'Tab' || input.value.slice(1) !== nombre) {
        e.preventDefault();
        completar(nombre);
      } else {
        ocultarSugerencias();
      }
    } else if (e.key === 'Escape') {
      ocultarSugerencias();
    }
  });

  listaSug.addEventListener('click', (e) => {
    const li = e.target.closest('li');
    if (li) completar(li.dataset.cmd);
  });

  document.addEventListener('click', (e) => {
    if (!zonaForm.contains(e.target)) ocultarSugerencias();
  });

  chipsWrap.addEventListener('click', (e) => {
    const btn = e.target.closest('.chip');
    if (!btn) return;
    enviar(btn.textContent.trim());
  });

  (async function boot_secuencia() {
    let modelo;
    try {
      modelo = await cargarModelo();
    } catch (err) {
      boot.innerHTML = `<p class="mono">&gt; error cargando el modelo: ${esc(err.message)}</p>`;
      return;
    }

    const m = modelo.metricas;
    const lineas = [
      `&gt; cargando aroa-1… ${m.documentos} documentos, 1 época, 0 GPUs`,
      `&gt; vocabulario: ${m.vocabulario} términos · accuracy@1: ${Math.round(m.accuracy_top1 * 100)}%`,
      `&gt; listo en ${modelo.cargaMs} ms`,
    ];
    boot.innerHTML = lineas.map((l) => `<p>${l}</p>`).join('');

    pintarFicha(modelo);
    prepararSelector();

    setTimeout(() => {
      heroCopy.hidden = false;
      chipsWrap.hidden = false;
      zonaForm.hidden = false;
      input.focus();
    }, 500);
  })();
</script>
